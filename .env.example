# ==========================================
# CivicConnect - Environment Configuration
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
SERVER_PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/civicconnect?schema=public"

# Authentication & Security
# Generate secure random strings for production
JWT_SECRET=civicconnect_super_secret_jwt_key_2026_production_grade
JWT_EXPIRES_IN=7d
COOKIE_SECRET=civicconnect_cookie_secret_key_99218274910247
BCRYPT_SALT_ROUNDS=10

# File Upload Configuration
UPLOAD_DIRECTORY=uploads
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/jpg

# AI Intelligence Service Configuration (Optional with deterministic fallbacks)
# Supported providers: local | gemini | openai
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_CONFIDENCE_THRESHOLD=0.75

# Default Admin Credentials (Seed only - Must be updated on production)
ADMIN_DEFAULT_EMAIL=admin@civicconnect.gov
ADMIN_DEFAULT_PASSWORD=AdminSecure2026!
