// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  ADMIN
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DuplicateReviewStatus {
  PENDING
  CONFIRMED_DUPLICATE
  NOT_A_DUPLICATE
}

model User {
  id           String        @id @default(uuid())
  fullName     String
  email        String        @unique
  phone        String?
  passwordHash String
  role         Role          @default(CITIZEN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  complaints   Complaint[]   @relation("CitizenComplaints")
  feedbacks    Feedback[]
  statusUpdates StatusHistory[] @relation("UpdatedByUser")
  resolutions  ResolutionRecord[] @relation("ResolvedByUser")
  auditLogs    AuditLog[]    @relation("AdminAuditLogs")

  @@map("users")
}

model Category {
  id          String      @id @default(uuid())
  name        String      @unique
  description String
  icon        String?
  createdAt   DateTime    @default(now())

  complaints  Complaint[]

  @@map("categories")
}

model Department {
  id          String      @id @default(uuid())
  name        String      @unique
  description String
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  complaints  Complaint[]

  @@map("departments")
}

model Complaint {
  id              String            @id @default(uuid())
  complaintNumber String            @unique
  userId          String
  categoryId      String
  departmentId    String?
  title           String
  description     String
  latitude        Float?
  longitude       Float?
  address         String?
  status          ComplaintStatus   @default(SUBMITTED)
  priority        Priority          @default(MEDIUM)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation("CitizenComplaints", fields: [userId], references: [id], onDelete: Cascade)
  category        Category          @relation(fields: [categoryId], references: [id])
  department      Department?       @relation(fields: [departmentId], references: [id])

  images          ComplaintImage[]
  statusHistory   StatusHistory[]
  resolution      ResolutionRecord?
  feedbacks       Feedback[]

  // Self-referencing duplicate relations
  duplicateSuggestionsPrimary   DuplicateSuggestion[] @relation("PrimaryComplaint")
  duplicateSuggestionsSecondary DuplicateSuggestion[] @relation("SecondaryComplaint")

  @@index([status])
  @@index([priority])
  @@index([categoryId])
  @@index([departmentId])
  @@index([userId])
  @@index([createdAt])
  @@map("complaints")
}

model ComplaintImage {
  id          String    @id @default(uuid())
  complaintId String
  storageKey  String
  fileName    String
  mimeType    String
  fileSize    Int       @default(0)
  createdAt   DateTime  @default(now())

  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_images")
}

model StatusHistory {
  id              String           @id @default(uuid())
  complaintId     String
  previousStatus  ComplaintStatus?
  newStatus       ComplaintStatus
  description     String
  updatedById     String
  createdAt       DateTime         @default(now())

  complaint       Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  updatedBy       User             @relation("UpdatedByUser", fields: [updatedById], references: [id])

  @@index([complaintId])
  @@index([createdAt])
  @@map("status_history")
}

model ResolutionRecord {
  id                    String            @id @default(uuid())
  complaintId           String            @unique
  resolutionDescription String
  resolvedById          String
  resolvedAt            DateTime          @default(now())
  createdAt             DateTime          @default(now())

  complaint             Complaint         @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  resolvedBy            User              @relation("ResolvedByUser", fields: [resolvedById], references: [id])
  images                ResolutionImage[]

  @@map("resolution_records")
}

model ResolutionImage {
  id           String           @id @default(uuid())
  resolutionId String
  storageKey   String
  fileName     String
  createdAt    DateTime         @default(now())

  resolution   ResolutionRecord @relation(fields: [resolutionId], references: [id], onDelete: Cascade)

  @@index([resolutionId])
  @@map("resolution_images")
}

model Feedback {
  id          String    @id @default(uuid())
  complaintId String
  userId      String
  rating      Int
  comments    String?
  createdAt   DateTime  @default(now())

  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([userId])
  @@map("feedbacks")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  entityType String
  entityId   String
  metadata   String?  // JSON stringified for flexible context
  createdAt  DateTime @default(now())

  admin      User     @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}

model DuplicateSuggestion {
  id                  String                @id @default(uuid())
  complaintId         String
  possibleDuplicateId String
  similarityScore     Float
  reason              String?
  reviewStatus        DuplicateReviewStatus @default(PENDING)
  reviewedById        String?
  createdAt           DateTime              @default(now())

  complaint           Complaint             @relation("PrimaryComplaint", fields: [complaintId], references: [id], onDelete: Cascade)
  possibleDuplicate   Complaint             @relation("SecondaryComplaint", fields: [possibleDuplicateId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([possibleDuplicateId])
  @@index([reviewStatus])
  @@map("duplicate_suggestions")
}

